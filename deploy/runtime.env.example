# Copy this file to deploy/runtime.env on the deployment host.
# Never commit deploy/runtime.env.
CLOSEREADY_LLM_ENABLED=1

# DeepSeek example
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# For another approved OpenAI-compatible provider, replace the four settings above:
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_MODEL=your-model-id
# LLM_BASE_URL=https://your-approved-provider.example/v1

# NUS-ISS organiser gateway (Ollama chat protocol with native tools):
# LLM_PROVIDER=ollama_gateway
# LLM_API_KEY=
# LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# LLM_BASE_URL=https://api.softwaresystems.app

LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200
LLM_OUTPUT_TOKEN_FIELD=max_tokens

# Mail: disabled, test_sink or smtp. smtp requires the settings below.
# CLOSEREADY_MAIL_BACKEND=test_sink
# CLOSEREADY_MAIL_BACKEND=smtp
# CLOSEREADY_SMTP_FROM=
# CLOSEREADY_SMTP_HOST=
# CLOSEREADY_SMTP_PORT=587
# CLOSEREADY_SMTP_SECURITY=starttls
# CLOSEREADY_SMTP_USERNAME=
# CLOSEREADY_SMTP_PASSWORD=
# CLOSEREADY_IMAP_HOST=
# CLOSEREADY_IMAP_PORT=993
# CLOSEREADY_IMAP_FOLDER=INBOX
