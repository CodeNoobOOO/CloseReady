# Copy to .env and fill locally. Never commit the actual key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Existing DEEPSEEK_* settings remain supported; default provider is deepseek.
# For a different compatible service, uncomment and fill ALL four settings below.
# Do not use a DeepSeek key for another endpoint.
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_MODEL=your-provider-model-id
# LLM_BASE_URL=https://your-approved-provider.example/v1
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_OUTPUT_TOKENS=1200
# LLM_OUTPUT_TOKEN_FIELD=max_tokens
# Some compatible endpoints require max_completion_tokens instead.

# Sandbox mail only. This is not live SMTP or a provider mailbox.
# Omit or set disabled to keep outbox items unsent.
# CLOSEREADY_MAIL_BACKEND=test_sink
