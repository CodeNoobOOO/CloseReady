# Copy to .env and fill locally. Never commit the actual key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Existing DEEPSEEK_* settings remain supported; default provider is deepseek.
# For a different compatible service, uncomment and fill ALL four settings below.
# Do not use a DeepSeek key for another endpoint.
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_MODEL=your-provider-model-id
# LLM_BASE_URL=https://your-approved-provider.example/v1
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_OUTPUT_TOKENS=1200
# LLM_OUTPUT_TOKEN_FIELD=max_tokens
# Some compatible endpoints require max_completion_tokens instead.

# Local OCR fallback for image-only PDFs. The Docker image includes Tesseract.
# CLOSEREADY_OCR_LANGUAGE=eng
# CLOSEREADY_OCR_DPI=200
# CLOSEREADY_OCR_MIN_CONFIDENCE=70
# CLOSEREADY_OCR_MIN_TEXT_CHARS=20
# CLOSEREADY_OCR_MAX_PAGES=20
# CLOSEREADY_OCR_PAGE_TIMEOUT_SECONDS=20
# On Windows outside Docker, set this to the installed tesseract.exe path.
# CLOSEREADY_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Sandbox mail only. This is not live SMTP or a provider mailbox.
# Omit or set disabled to keep outbox items unsent.
# CLOSEREADY_MAIL_BACKEND=test_sink

# Live personal mailbox. Fill locally; never commit the password.
# CLOSEREADY_MAIL_BACKEND=smtp
# CLOSEREADY_SMTP_FROM=
# CLOSEREADY_SMTP_HOST=smtp.gmail.com
# CLOSEREADY_SMTP_PORT=587
# CLOSEREADY_SMTP_SECURITY=starttls
# CLOSEREADY_SMTP_USERNAME=
# CLOSEREADY_SMTP_PASSWORD=
# CLOSEREADY_IMAP_HOST=imap.gmail.com
# CLOSEREADY_IMAP_PORT=993
# CLOSEREADY_IMAP_FOLDER=INBOX
# CLOSEREADY_MAIL_TIMEOUT_SECONDS=30
